## 2.3) Fungi ridge----

### 2.3.1  Extract the optimal parameter----
fungi.ridge.best_idx <- which.min(fungi.ridge.cv_results$rmse_at_best_nrounds)
fungi.ridge.best_params <- param_grid[fungi.ridge.best_idx, ]
fungi.ridge.best_nrounds <- fungi.ridge.cv_results$best_nrounds[fungi.ridge.best_idx]


### 2.3.2 Train the optimal model----
set.seed(20260430)

fungi.ridge.final_model <- xgb.train(
  params = list(
    booster = "gbtree",
    objective = "reg:squarederror",
    eval_metric = "rmse",
    eta = fungi.ridge.best_params$eta,
    max_depth = fungi.ridge.best_params$max_depth,
    min_child_weight = fungi.ridge.best_params$min_child_weight,
    gamma = fungi.ridge.best_params$gamma,
    subsample = fungi.ridge.best_params$subsample,
    colsample_bytree = fungi.ridge.best_params$colsample_bytree,
    lambda = fungi.ridge.best_params$lambda,
    alpha = fungi.ridge.best_params$alpha,
    nthread = 1
  ),
  data = fungi.ridge.dtrain,
  nrounds = fungi.ridge.best_nrounds,
  verbose = 1
)


### 2.3.3 Testing model performance----
fungi.ridge.pred_test <- predict(fungi.ridge.final_model,
                                 as.matrix(fungi.ridge.test_data[, fungi.target.gene]))

fungi.ridge.test.result <- data.frame(pred = fungi.ridge.pred_test,
                                      obs = fungi.ridge.test_data$Abundance_shift)

postResample(pred = fungi.ridge.test.result$pred, obs = fungi.ridge.test.result$obs)


### Fig.S7_fungi.ridge----
fungi.ridge.test.result %>%
  ggplot(aes(x = obs, y = pred)) +
  geom_point(size = 6, shape = 21, fill = "#AB5DF9") +
  stat_cor(size = 10) +
  stat_smooth(geom = "smooth", formula = "y ~ x", alpha = 1,
              se = T, method = "lm", fill = "#AD8DCD",
              colour = "#CD4FE7", linewidth = 1.5) +
  labs(x = "Observed value", y = "Predicted value") +
  scale_x_continuous(limits = c(-7, 3), breaks = seq(-7, 3, 2)) +
  scale_y_continuous(limits = c(-3, 2), breaks = seq(-3, 2, 1)) +
  theme_bw(base_size = 16) +
  theme(panel.border = element_rect(colour = "black",
                                    linewidth = 1,
                                    fill = NA),
        panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.20, "cm"),
        axis.ticks.length.y = unit(-0.20, "cm"))


### 2.3.4 SHAP Analysis----
fungi.ridge.shap_long <- shap.prep(xgb_model = fungi.ridge.final_model,
                                   X_train = as.matrix(fungi.ridge.train_data[, fungi.target.gene])) %>%
  data.frame() %>%
  group_by(variable) %>%
  mutate(across(stdfvalue, ~ (.-min(.)) / (max(.) - min(.))),
         Type = case_when(variable %in% c("Exo_amylase", "Exo_cellulase", "Exo_hemicellulose",
                                          "Exo_chitosanase") ~ "Exo_enzyme",
                          variable %in% c("Endo_amylase", "Endo_cellulase", "Endo_hemicellulose",
                                          "Endo_chitosanase", "Ligninase") ~ "Endo_enzyme",
                          .default = "TEA"))


### 2.3.5 Variable importance
fungi.ridge_importance <- fungi.ridge.shap_long %>%
  group_by(variable) %>%
  summarise(mean_abs_shap = mean(abs(value))) %>%
  arrange(desc(mean_abs_shap))

head(fungi.ridge.shap_long)


### 2.3.6 Swarm_Plot----
fungi.ridge_SHAP_Swarm_Plot <- fungi.ridge.shap_long %>%
  ggplot(aes(x = value, y = reorder(variable, mean_value))) +
  geom_vline(xintercept = 0, linetype = 2, color = "black", linewidth = 0.5) +
  geom_point(aes(fill = stdfvalue),
             shape = 21, size = 3.5,
             stroke = 0, alpha = 1, color = "black",
             position = position_jitter(height = 0.06, seed = 1234)) +
  scale_fill_gradientn(colours = c("blue", "red"),
                       values = scales::rescale(c(0, 0.25, 0.5, 0.75, 1)),
                       name = "Feature value",
                       breaks = c(0, 1),
                       labels = c("Low", "High"),
                       guide = guide_colourbar(
                         title.position = "bottom",
                         title.hjust = 0.5,
                         title.vjust = 4,
                         barwidth = unit(8, "cm"),
                         barheight = unit(0.2, "cm"))) +
  labs(x = "SHAP value (Impact on model output)",
       y = NULL, fill = NULL,
       title = "Fungi ridge") +
  theme_bw(base_size = 16) +
  theme(legend.position = "bottom",
        panel.grid = element_blank(),
        axis.title.x.bottom = element_text(vjust = -2),
        legend.box.margin = margin(r = 10),
        plot.margin = margin(10, 0, 5, 5),
        axis.ticks.length = unit(-0.15, "cm"))


### 2.3.7 Variable importance plot----
fungi.ridge_Feature_Importance_Plot <- fungi.ridge_importance %>%
  ggplot(aes(x = mean_abs_shap, y = reorder(variable, mean_abs_shap))) +
  geom_col(fill = "grey80", width = 0.6, color = "black") +
  scale_x_continuous(limits = c(0, 0.4), breaks = seq(0, 0.4, 0.2),
                     expand =  expansion(0, 0), position = "top") +
  labs(x = "Mean |SHAP|", y = NULL) +
  theme_minimal(base_size = 16) +
  theme(axis.text.y = element_blank(),
        panel.grid = element_blank(),
        axis.line.x = element_line(),
        axis.ticks.x = element_line(), 
        plot.margin = margin(10, 10, 5, 0),
        axis.title.x.top = element_text(vjust = 2),
        axis.ticks.length = unit(-0.15, "cm"))


### 2.3.8 Merge Graphics----
fungi.ridge_SHAP_Swarm_Plot + 
  fungi.ridge_Feature_Importance_Plot + 
  plot_layout(widths = c(3.5, 1.5))

fungi.ridge.plot.variable <- fungi.ridge.shap_long %>%
  mutate(Type = factor(Type, levels = c("Exo_enzyme", "Endo_enzyme", "TEA"))) %>%
  arrange(desc(mean_value)) %>%
  distinct(Type, variable) %>%
  group_by(Type) %>% 
  dplyr::slice(1:2) %>%
  pull(variable) %>% as.character()


### 2.3.9 Relationship between gene number and SHAP values----
fungi.ridge.shap_long %>%
  subset(variable %in% fungi.ridge.plot.variable) %>%
  mutate(variable = factor(variable, levels = fungi.ridge.plot.variable)) %>%
  ungroup() %>%
  ggplot(aes(x = rfvalue, y = value)) +
  geom_hline(yintercept = 0, linetype = 2, linewidth = 0.5) +
  geom_point(size = 5, fill = "#FFC69B", shape = 21, color = "black") + 
  geom_smooth(method = "lm", formula = y ~ log1p(x), fill = "#BF7843",
              linewidth = 2, alpha = 1, colour = "#E60012") + 
  facet_wrap(~ variable, scale = "free", nrow = 1) +
  facetted_pos_scales(
    x = list(variable == fungi.ridge.plot.variable[1] ~ scale_x_continuous(
      limits = c(0, 50), breaks = seq(0, 50, 10),
      expand = expansion(mult = 0.1, add = 0.1)),
      variable == fungi.ridge.plot.variable[2] ~ scale_x_continuous(
        limits = c(0, 5), breaks = seq(0, 5, 1),
        expand = expansion(mult = 0.1, add = 0.1)),
      variable == fungi.ridge.plot.variable[3] ~ scale_x_continuous(
        limits = c(0, 10), breaks = seq(0, 10, 2),
        expand = expansion(mult = 0.1, add = 0.1)),
      variable %in% fungi.ridge.plot.variable[4] ~ scale_x_continuous(
        limits = c(0, 50), breaks = seq(0, 50, 10),
        expand = expansion(mult = 0.1, add = 0.1))),
    y = list(variable %in% fungi.ridge.plot.variable[1:2] ~ scale_y_continuous(
      limits = c(-0.9, 0.3), breaks = round(seq(-0.9, 0.3, 0.3), 1)),
      variable %in% fungi.ridge.plot.variable[3] ~ scale_y_continuous(
        limits = c(-1.5, 0.5), breaks = round(seq(-1.5, 0.5, 0.5), 1)),
      variable == fungi.ridge.plot.variable[4] ~ scale_y_continuous(
        limits = c(-1.5, 0.5), breaks = round(seq(-1.5, 0.5, 0.5), 1)))) +
  labs(x = "Target KO count", y = "SHAP value") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length = unit(-0.15, "cm"))


## 2.4) Fungi valley----

### 2.4.1  Extract the optimal parameter----
fungi.valley.best_idx <- which.min(fungi.valley.cv_results$rmse_at_best_nrounds)
fungi.valley.best_params <- param_grid[fungi.valley.best_idx, ]
fungi.valley.best_nrounds <- fungi.valley.cv_results$best_nrounds[fungi.valley.best_idx]


### 2.4.2 Train the optimal model----
set.seed(20260430)

fungi.valley.final_model <- xgb.train(
  params = list(
    booster = "gbtree",
    objective = "reg:squarederror",
    eval_metric = "rmse",
    eta = fungi.valley.best_params$eta,
    max_depth = fungi.valley.best_params$max_depth,
    min_child_weight = fungi.valley.best_params$min_child_weight,
    gamma = fungi.valley.best_params$gamma,
    subsample = fungi.valley.best_params$subsample,
    colsample_bytree = fungi.valley.best_params$colsample_bytree,
    lambda = fungi.valley.best_params$lambda,
    alpha = fungi.valley.best_params$alpha,
    nthread = 1
  ),
  data = fungi.valley.dtrain,
  nrounds = fungi.valley.best_nrounds,
  verbose = 1
)


### 2.4.3 Testing model performance----
