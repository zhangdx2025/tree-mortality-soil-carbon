# 4. Microbial functional profiles----
target.gene <- c("Exo_amylase", "Endo_amylase", "Exo_cellulase", "Endo_cellulase",
                 "Exo_hemicellulose", "Endo_hemicellulose", "Exo_chitosanase",
                 "Endo_chitosanase", "Ligninase", "TEA_Oxygen", "TEA_Nitrate",
                 "TEA_Sulfite")

cell_fun = function(j, i, x, y, width, height, fill) {
  grid.rect(x = x, y = y,
            width = width, height = height,
            gp = gpar(col = "grey80", lwd = 0.5, fill = NA))  
}


## 4.1) Bacteria----
mat.bacteria <- bacterial.amplicon.traits_target.gene.counts %>%
  group_by(Phylum, Class, Order, Family, Genus, Species) %>%
  summarise(across(all_of(target.gene), ~ sum(.x)), .groups = "drop") %>%
  mutate(across(all_of(target.gene), ~ ifelse(.x > 0, 1, 0)),
         row.names = NULL) %>%
  arrange(rowSums(across(all_of(target.gene)))) %>%
  select(Species, all_of(target.gene)) %>%
  column_to_rownames("Species") %>%
  as.matrix()


### 3.1.1 Heatmap generation----
Heatmap(t(mat.bacteria), cluster_columns = F,
        cluster_rows = F,
        col = colorRamp2(c(0, 1), c("white", "#FC477A")),
        show_column_names = FALSE,
        show_row_names = TRUE,
        show_heatmap_legend = FALSE,
        cell_fun = cell_fun)


# 3.2) Fungi----
mat.fungi <- fungal.amplicon.traits_target.gene.counts %>%
  group_by(Species) %>%
  summarise(across(all_of(target.gene), ~ sum(.x)), .groups = "drop") %>%
  mutate(across(all_of(target.gene), ~ ifelse(.x > 0, 1, 0)),
         row.names = NULL) %>%
  arrange(rowSums(across(all_of(target.gene)))) %>%
  select(Species, all_of(target.gene)) %>%
  column_to_rownames("Species") %>%
  as.matrix()


### 3.2.1 Heatmap generation----
Heatmap(t(mat.fungi), cluster_columns = F,
        cluster_rows = F,
        col = colorRamp2(c(0, 1), c("white", "#AD5EFC")),
        show_column_names = FALSE,
        show_row_names = TRUE,
        show_heatmap_legend = FALSE,
        cell_fun = cell_fun)


# 4. Distribution of functional trait counts across bacterial species----

## 4.1) Bacteria----
mat.bacteria %>%
  rowSums() %>%
  data.frame(Gene.Count = .) %>%
  ggplot(aes(x = Gene.Count)) +
  geom_histogram(aes(y = after_stat(count / sum(count))),
                 binwidth = 1, fill = "#FC477A", color = "grey30", boundary = 0) +
  geom_density(alpha = 1, adjust = 4, bw = 0.3, show.legend = F,
               linewidth = 1) +
  scale_x_continuous(breaks = 0:12, limits = c(0, 12), expand = c(0.01, 0.01)) +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.2),
                     expand = expansion(mult = c(0.001, 0.05))) +
  labs(x = "Number of KO-supported target functions per species",
       y = "Proportion of species") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"))


## 4.2) Fungi----
mat.fungi %>%
  rowSums() %>%
  data.frame(Gene.Count = .) %>%
  ggplot(aes(x = Gene.Count)) +
  geom_histogram(aes(y = after_stat(count / sum(count))),
                 binwidth = 1, fill = "#AD5EFC", color = "grey30", boundary = 0) +
  geom_density(alpha = 1, adjust = 4, bw = 0.15, show.legend = F,
               linewidth = 1) +
  scale_x_continuous(breaks = 0:12, limits = c(0, 12), expand = c(0.01, 0.01)) +
  scale_y_continuous(limits = c(0, 1), breaks = seq(0, 1, 0.2),
                     expand = expansion(mult = c(0.001, 0.05))) +
  labs(x = "Number of KO-supported target functions per species",
       y = "Proportion of species") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"))


# 5 Distribution of Jaccard-based functional dissimilarity----
Jaccard.distance.bacteria <- mat.bacteria %>%
  as.matrix() %>%
  vegdist(method = "jaccard", binary = TRUE, diag = FALSE) %>%
  as.vector()

Jaccard.distance.fungi <- mat.fungi %>%
  as.matrix() %>%
  vegdist(method = "jaccard", binary = TRUE, diag = FALSE) %>%
  as.vector()


## 5.1) Kernel density plot----
data.frame(Group = c(rep("Bacteria", length(Jaccard.distance.bacteria)),
                     rep("Fungi", length(Jaccard.distance.fungi))),
           Jaccard.distance = c(Jaccard.distance.bacteria, Jaccard.distance.fungi)) %>%
  subset(!is.na(Jaccard.distance)) %>%
  ggplot(aes(x = Jaccard.distance, fill = Group)) +
  geom_density(alpha = 0.7, adjust = 4, bw = 0.03, show.legend = F) +
  scale_y_continuous(limits = c(0, 5), breaks = seq(0, 5, 1),
                     expand = expansion(mult = c(0.001, 0.001))) +
  scale_fill_manual(values = c("Bacteria" = "#FC477A", "Fungi" = "#AD5EFC")) +
  labs(x = "Jaccard distance",
       y = "Relative frequency") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"))
