# Set the working directory
setwd("~R_script")

path_microbial.trait <- file.path(getwd(), "Data", "Microbial_trait")
path_microbial.composition <- file.path(getwd(), "Data", "Microbial_composition")
path_result.output <- file.path(getwd(), "Result_output")


# load library
library(tidyverse)
library(readxl)
library(metacoder)
library(ComplexHeatmap)
library(circlize)
library(vegan)


# 1. Load data----
load(file.path(path_result.output, "all_genome_target.gene.counts.Rdata"))
load(file.path(path_result.output, "microbial_composition_results.Rdata"))

Bacterial.species_taxonomic.name <- read_excel(file.path(path_microbial.trait,
                                                         "Bacterial.species_taxonomic.name.xlsx")) %>%
  data.frame() %>%
  na.omit()

Fungal.genus_taxonomic.name <- read_excel(file.path(path_microbial.trait,
                                                    "Fungal.genus_taxonomic.name.xlsx")) %>%
  data.frame() %>%
  na.omit()

Fungal.species_taxonomic.name <- read_excel(file.path(path_microbial.trait,
                                                      "Fungal.species_taxonomic.name.xlsx")) %>%
  data.frame() %>%
  na.omit()


# 2 Table.S5----
# Matched amplified taxa to genomes

Taxonomic.rank <- c("Phylum", "Class", "Order", "Family", "Genus", "Species")


## 2.1) Bacteria----

### 2.1.1 Number of genomes----
length(unique(bacterial.amplicon.traits_target.gene.counts$Accession))


### 2.1.2 Genome coverage----
Bacterial.genome.profiles <- list()

for (i in seq_along(Taxonomic.rank)) {
  
  
  # Total.taxon.list
  total.amplicon.taxon.list <- bacteria.table %>%
    select(all_of(Taxonomic.rank[i])) %>%
    deframe() %>% unique()
  
  
  # Number of total taxa
  total.amplicon.taxon.number <- length(total.amplicon.taxon.list)
  
  
  # Classified.taxon.list
  classified.amplicon.taxon.list <- total.amplicon.taxon.list[!grepl("Unc\\.", total.amplicon.taxon.list)]
  
  
  # Number of classified taxa
  classified.amplicon.taxon.number <- length(classified.amplicon.taxon.list)
  
  
  # Genomes taxon Silva names
  genome.taxon.SILVA.name.list <- bacterial.amplicon.traits_target.gene.counts %>%
    rename("Taxonomic.rank" = Taxonomic.rank[i]) %>%
    pull(Taxonomic.rank) %>% unique()
  
  
  # Number of taxa with genome
  genome.taxon.number <- length(genome.taxon.SILVA.name.list)
  
  
  # Relative abundance covered by amplicon taxa with genomes
  prop.genome.taxa.all <- bacteria.table %>%
    rename("Taxonomic.level" = Taxonomic.rank[i]) %>%
    subset(Taxonomic.level %in% genome.taxon.SILVA.name.list) %>%
    select(where(is.numeric)) %>%
    colSums()
  
  classified.amplicon.taxon.abundance <- bacteria.table %>%
    rename("Taxonomic.level" = Taxonomic.rank[i]) %>%
    subset(Taxonomic.level %in% classified.amplicon.taxon.list) %>%
    select(where(is.numeric)) %>%
    colSums()
  
  
  # Save Bacterial genome profiles
  Bacterial.genome.profiles[[i]] <- data.frame(
    Amplicon.taxon.number = total.amplicon.taxon.number,
    Classified.amplicon.taxon.number = classified.amplicon.taxon.number,
    Classified.amplicon.taxon.abundance = paste(round(mean(classified.amplicon.taxon.abundance), 3),
                                                round(sd(classified.amplicon.taxon.abundance), 3),
                                                sep = " ± "),
    Genome.taxon.number  = genome.taxon.number,
    
    Prop.genome.taxon.all = paste(round(mean(prop.genome.taxa.all), 3),
                                  round(sd(prop.genome.taxa.all), 3),
                                  sep = " ± "),
    Prop.genome.taxon.classified = paste(round(mean(prop.genome.taxa.all / classified.amplicon.taxon.abundance), 3),
                                         round(sd(prop.genome.taxa.all / classified.amplicon.taxon.abundance), 3),
                                         sep = " ± "))
  
  names(Bacterial.genome.profiles)[i] <- Taxonomic.rank[i]
}


Bacterial.genome.profiles %>%
  bind_rows(.id = "Taxonomic.level")


## 2.2) Fungi----

### 2.2.1 Number of genomes----
length(unique(fungal.amplicon.traits_target.gene.counts$Accession))


### 2.2.2 Genome coverage----
Fungal.genome.profiles <- list()

for (i in seq_along(Taxonomic.rank)) {
  
  
  # Total.taxon.list
  total.amplicon.taxon.list <- fungi.table %>%
    select(all_of(Taxonomic.rank[i])) %>%
    deframe() %>% unique()
  
  
  # Number of total taxa
  total.amplicon.taxon.number <- length(total.amplicon.taxon.list)
  
  
  # Classified.taxon.list
  classified.amplicon.taxon.list <- total.amplicon.taxon.list[!grepl("Unc\\.", total.amplicon.taxon.list)]
  
  
  # Number of classified taxa
  classified.amplicon.taxon.number <- length(classified.amplicon.taxon.list)
  
  
  # Genomes taxon UNITE names
  # Note: The nomenclature of fungal taxa follows that used in the UNITE database.
  if(Taxonomic.rank[i] == "Species") {
    genome.taxon.UNITE.name.list <- fungal.amplicon.traits_target.gene.counts %>%
      rename("Taxonomic.rank" = Taxonomic.rank[i]) %>%
      left_join(Fungal.species_taxonomic.name, join_by(Taxonomic.rank == Ncbi.name)) %>%
      subset(Amplicon.name %in% total.amplicon.taxon.list) %>%
      pull(Amplicon.name) %>% unique()
    
  } else {
    genome.taxon.UNITE.name.list <- fungal.amplicon.traits_target.gene.counts %>%
      rename("Taxonomic.rank" = Taxonomic.rank[i]) %>%
      pull(Taxonomic.rank) %>% unique()
  }
  
  
  # Number of taxa with genome
  genome.taxon.number <- length(genome.taxon.UNITE.name.list)
  
  
  # Relative abundance covered by amplicon taxa with genomes
  prop.genome.taxa.all <- fungi.table %>%
    rename("Taxonomic.level" = Taxonomic.rank[i]) %>%
    subset(Taxonomic.level %in% genome.taxon.UNITE.name.list) %>%
    select(where(is.numeric)) %>%
    colSums()
  
  classified.amplicon.taxon.abundance <- fungi.table %>%
    rename("Taxonomic.level" = Taxonomic.rank[i]) %>%
    subset(Taxonomic.level %in% classified.amplicon.taxon.list) %>%
    select(where(is.numeric)) %>%
    colSums()
  
  
  # Save Fungal genome profiles
  Fungal.genome.profiles[[i]] <- data.frame(
    Amplicon.taxon.number = total.amplicon.taxon.number,
    Classified.amplicon.taxon.number = classified.amplicon.taxon.number,
    Classified.amplicon.taxon.abundance = paste(round(mean(classified.amplicon.taxon.abundance), 3),
                                                round(sd(classified.amplicon.taxon.abundance), 3),
                                                sep = " ± "),
    Genome.taxon.number  = genome.taxon.number,
    
    Prop.genome.taxon.all = paste(round(mean(prop.genome.taxa.all), 3),
                                  round(sd(prop.genome.taxa.all), 3),
                                  sep = " ± "),
    Prop.genome.taxon.classified = paste(round(mean(prop.genome.taxa.all / classified.amplicon.taxon.abundance), 3),
                                         round(sd(prop.genome.taxa.all / classified.amplicon.taxon.abundance), 3),
                                         sep = " ± "))
  
  names(Fungal.genome.profiles)[i] <- Taxonomic.rank[i]
}

Fungal.genome.profiles %>%
  bind_rows(.id = "Taxonomic.level")


# 3 Genomic phylogenetic distribution----

## 3.1) Bacteria----
bacteria.object <- bacterial.amplicon.traits_target.gene.counts %>%
  distinct(Phylum, Class, Order, Family, Genus, Species) %>%
  select(Phylum, Class, Order) %>%
  add_column(Bacteria = "Bacteria", .before = 1) %>%
  parse_tax_data(class_cols = c("Bacteria", "Phylum",
                                "Class", "Order"),
                 class_key = "taxon_name",
                 named_by_rank = T)


### 3.1.1 Fig.4a----
heat_tree(
  bacteria.object,
  node_label = taxon_names,
  node_size = n_obs,  
  node_color = n_obs,
  node_color_range = c("#FEE8EE", "#BF2652"),
  node_size_trans = "log10 area",
  edge_size_trans = "log10 area",
  make_node_legend = T,
  node_color_interval = c(1, 187),
  node_size_interval = c(1, 187),
  node_size_range = c(0.005, 0.06),
  node_label_size_range = c(0.02, 0.06),
  edge_size_range = c(0.003, 0.02),
  node_size_axis_label = "Number of species",
  node_color_axis_label = "Number of species"
) 


### 3.1.2 Number of genome-matched species within each taxon----

# Note: Taxon names are labeled only for nodes 
# with at least 4 species in the main text.
bacterial.amplicon.traits_target.gene.counts %>%
  distinct(Phylum, Class, Order, Family, Genus, Species) %>%
  nrow()

bacterial.amplicon.traits_target.gene.counts %>%
  distinct(Phylum, Class, Order, Family, Genus, Species) %>%
  group_by(Phylum, Class, Order) %>%
  summarise(N = n(), .groups = "drop") %>%
  arrange(desc(N)) %>%
  data.frame() %>%
  subset(N >= 4)

bacterial.amplicon.traits_target.gene.counts %>%
  distinct(Phylum, Class, Order, Family, Genus, Species) %>%
  group_by(Phylum, Class) %>%
  summarise(N = n(), .groups = "drop") %>%
  arrange(desc(N)) %>%
  data.frame() %>%
  subset(N >= 4)

bacterial.amplicon.traits_target.gene.counts %>%
  distinct(Phylum, Class, Order, Family, Genus, Species) %>%
  group_by(Phylum) %>%
  summarise(N = n(), .groups = "drop") %>%
  arrange(desc(N)) %>%
  data.frame() %>%
  subset(N >= 4)


