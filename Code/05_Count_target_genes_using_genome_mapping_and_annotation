## 3.8) Merge taxonomy information with genome reports----
# Create a unified tax_id column for genome reports

genome_selected <- fungal.genome.reports %>%
  transmute(
    Accession = accession,
    Organism_name = organism.organism_name,
    Strain = organism.infraspecific_names.strain,
    tax_id = as.integer(`organism.tax_id`),
    Assembly_level = assembly_info.assembly_level,
    Genome_size = assembly_stats.total_ungapped_length,
    Genome_coverage = assembly_stats.genome_coverage,
    Scaffolds_number = assembly_stats.number_of_scaffolds,
    Scaffold_N50 = assembly_stats.scaffold_n50,
    Scaffold_L50 = assembly_stats.scaffold_l50,
    Contigs_number = assembly_stats.number_of_contigs,
    Contigs_N50 = assembly_stats.contig_n50,
    Contigs_L50 = assembly_stats.contig_l50,
    Number_of_organelles = assembly_stats.number_of_organelles,
    BUSCO_complete = annotation_info.busco.complete,
    BUSCO_duplicated = annotation_info.busco.duplicated
  )

head(genome_selected)

# Merge genome and taxonomy information by tax_id
fungi.genome.info.ncbi <- genome_selected %>%
  left_join(taxonomy_selected, by = "tax_id") %>%
  transmute(Accession, Kingdom = kingdom,
            Phylum = phylum, Class = class,
            Order = order, Family = family,
            Genus = genus, Species = species,
            Strain = Strain, Tax_id = tax_id,
            Assembly_level,  Genome_size,  Genome_coverage,
            Scaffolds_number, Scaffold_N50, Scaffold_L50,
            Contigs_number, Contigs_N50, Contigs_L50,
            Number_of_organelles)

nrow(fungi.genome.info.ncbi)

fungi.genome <- fungi.genome.info.ncbi %>%
  filter(Scaffold_N50 > 100000,
         Scaffolds_number < 200,
         Genome_coverage >= 30) %>%
  arrange(desc(Scaffold_N50), desc(Genome_coverage), desc(Scaffolds_number)) %>%
  distinct(Species, Strain, .keep_all = T)

nrow(fungi.genome)


