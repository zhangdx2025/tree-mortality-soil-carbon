## 1.1) Bacterial genomes----

# Data source:
# https://data.gtdb.ecogenomic.org/releases/release226


# Select high-quality bacterial genomes
bacteria.metadata <- read_tsv(file.path(path_microbial.trait,
                                        "bac120_metadata_r226.tsv.gz"),
                              show_col_types = FALSE) %>%
  mutate(species_with_prefix = str_extract(gtdb_taxonomy, "s__[^;]+"),
         species_raw = str_remove(species_with_prefix, "^s__"),
         species_clean1 = str_replace(species_raw, "^([A-Za-z]+)_\\w+\\s", "\\1 "),
         Species = str_replace(species_clean1, " ([a-z]+)_\\w+$", " \\1")) %>%
  filter(checkm_completeness >= 90,
         checkm_contamination <= 5) %>%
  arrange(desc(checkm_completeness), checkm_contamination) %>%
  distinct(Species, ncbi_strain_identifiers, .keep_all = TRUE) %>%
  separate(col = gtdb_taxonomy,
           into = c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus",
                    "species_with_prefix"),
           sep = ";",
           fill = "right",
           remove = TRUE) %>%
  mutate(species_raw = sub("s__", "", species_with_prefix),
         species_clean1 = sub("^([A-Za-z]+)_\\w+\\s", "\\1 ", species_raw),
         Species = sub(" ([a-z]+)_\\w+$", " \\1", species_clean1)) %>%
  mutate(across(Kingdom:Species, ~ sub("^[a-z]__*", "", .)),
         Strain = paste(Species, ncbi_strain_identifiers)) %>%
  transmute(ncbi_genbank_assembly_accession,
            Kingdom, Phylum, Class, Order, Family, Genus,
            Species, Strain,
            Checkm_completeness = checkm_completeness,
            Checkm_contamination = checkm_contamination,
            Genome_size = genome_size)

