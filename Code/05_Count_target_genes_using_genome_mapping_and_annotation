# 3 Download fungal genome information from NCBI Datasets----

# Date: 2026.04.29

## 3.1) Set the NCBI API endpoint and request headers----

base_url <- "https://api.ncbi.nlm.nih.gov/datasets/v2/genome/taxon/4751/dataset_report"

# Taxonomy endpoint
taxonomy_base_url <- "https://api.ncbi.nlm.nih.gov/datasets/v2/taxonomy/taxon"


# Read the NCBI API key from the system environment variable
# The script can run without an API key, but access may be rate-limited

ncbi_api_key <- Sys.getenv("NCBI_API_KEY")

# Set request headers
headers <- if (nzchar(ncbi_api_key)) {
  add_headers(
    "accept" = "application/json",
    "api-key" = ncbi_api_key
  )
} else {
  add_headers(
    "accept" = "application/json"
  )
}


## 3.2) Download fungal genome reports by page----

# Store genome reports from each page
Fungi_all_reports <- list()

# Initialize pagination
page_token <- NULL
page <- 1

repeat {
  
  # Set query parameters
  query_params <- list(
    "filters.reference_only" = "false",
    "filters.assembly_source" = "all", 
    "filters.has_annotation" = "true",
    "filters.exclude_paired_reports" = "false",
    "filters.exclude_atypical" = "true",
    "filters.assembly_version" = "current",
    "returned_content" = "COMPLETE",
    "page_size" = 1000
  )
  
  # Continue with the next page if a page token is available
  if (!is.null(page_token)) {
    query_params$page_token <- page_token
  }
  
  cat("Downloading genome report page", page, "...\n")
  
  # Use RETRY to handle transient network failures
  res <- RETRY(
    verb = "GET",
    url = base_url,
    headers,
    query = query_params,
    times = 5,
    pause_min = 1,
    pause_cap = 20
  )
  
  if (status_code(res) != 200) {
    stop("Request failed with status code: ", status_code(res))
  }
  
  # Parse the returned JSON data
  json_data <- fromJSON(
    content(res, "text", encoding = "UTF-8"),
    flatten = TRUE
  )
  
  # Save records from the current page
  if (!is.null(json_data$reports) && nrow(json_data$reports) > 0) {
    Fungi_all_reports[[page]] <- json_data$reports
    
    cat(
      "Page", page, "was successfully read with",
      nrow(json_data$reports), "records.\n"
    )
  } else {
    cat("Page", page, "has no records and was skipped.\n")
  }
  
  # Update the next page token
  page_token <- json_data$next_page_token
  
  cat(
    "Current page token:",
    ifelse(is.null(page_token), "none", page_token),
    "\n\n"
  )
  
  # Stop when no further pages are available
  if (is.null(page_token)) {
    cat("All genome data were successfully downloaded.\n")
    break
  }
  
  page <- page + 1
  
  # Avoid overly frequent requests
  Sys.sleep(1)
}


## 3.3) Merge paginated genome reports----

# Remove empty results
Fungi_all_reports <- Filter(Negate(is.null), Fungi_all_reports)

# Merge all paginated records
fungal.genome.reports <- bind_rows(Fungi_all_reports)

cat("Total genome records:", nrow(fungal.genome.reports), "\n")
cat("Total columns:", ncol(fungal.genome.reports), "\n")


## 3.4) Extract taxonomy IDs for fungal genomes----

# Extract taxonomy IDs from genome reports
fungal.tax_ids <- fungal.genome.reports %>%
  distinct(`organism.tax_id`) %>%
  filter(!is.na(`organism.tax_id`)) %>%
  pull(`organism.tax_id`) %>%
  as.character()

cat("Total unique taxonomy IDs:", length(fungal.tax_ids), "\n")

head(fungal.tax_ids)


## 3.5) Download taxonomy reports in batches----

# Download 100 taxonomy IDs per batch
# Increase to 200 or 500 if the network connection is stable
batch_size <- 100

# Split taxonomy IDs into batches
tax_id_batches <- split(
  fungal.tax_ids,
  ceiling(seq_along(fungal.tax_ids) / batch_size)
)

# Store taxonomy reports from each batch
fungal.taxonomy_reports_list <- list()

for (i in seq_along(tax_id_batches)) {
  
  cat("Downloading taxonomy batch", i, "of", length(tax_id_batches), "...\n")
  
  # Combine taxonomy IDs in the current batch
  current_fungal.tax_ids <- paste(tax_id_batches[[i]], collapse = ",")
  
  # Construct the taxonomy report endpoint
  taxonomy_url <- paste0(
    taxonomy_base_url,
    "/",
    current_fungal.tax_ids,
    "/dataset_report"
  )
  
  # Request taxonomy reports
  res_taxonomy <- RETRY(
    verb = "GET",
    url = taxonomy_url,
    headers,
    query = list(
      "returned_content" = "COMPLETE",
      "page_size" = 1000
    ),
    times = 5,
    pause_min = 1,
    pause_cap = 20
  )
  
  if (status_code(res_taxonomy) != 200) {
    stop("Taxonomy request failed with status code: ", status_code(res_taxonomy))
  }
  
  # Parse the returned JSON data
  taxonomy_json <- fromJSON(
    content(res_taxonomy, "text", encoding = "UTF-8"),
    flatten = TRUE
  )
  
  # Save taxonomy records from the current batch
  if (!is.null(taxonomy_json$reports) && nrow(taxonomy_json$reports) > 0) {
    fungal.taxonomy_reports_list[[i]] <- taxonomy_json$reports
    
    cat(
      "Batch", i, "was successfully read with",
      nrow(taxonomy_json$reports), "records.\n\n"
    )
  } else {
    cat("Batch", i, "has no taxonomy records.\n\n")
  }
  
  # Avoid overly frequent requests
  Sys.sleep(1)
}


## 3.6) Merge taxonomy reports----

# Remove empty results
fungal.taxonomy_reports_list <- Filter(Negate(is.null), fungal.taxonomy_reports_list)

# Merge all taxonomy records
taxonomy_reports <- bind_rows(fungal.taxonomy_reports_list)

cat("Total taxonomy records:", nrow(taxonomy_reports), "\n")
cat("Total columns:", ncol(taxonomy_reports), "\n")

