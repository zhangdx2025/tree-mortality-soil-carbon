# 2 Paired comparison----

## 2.1) Normality and Heteroscedasticity test----

for (i in seq_along(variable.name)) {
  
  df <- data.carbon.fraction %>%
    select(all_of(c("Sample.ID", "Pairs", "Status",
                    "Topography", variable.name[i]))) %>%
    rename("Variable" = variable.name[i])
  
  
  model <- lmer(Variable ~ Status * Topography + (1 | Pairs),
                data = df)
  
  cat("Normality test: Variable =", variable.name[i], "\n")
  
  # Normality test
  check_normality(model) %>% print()
  
  cat("Heteroscedasticity test: Variable =", variable.name[i], "\n")
  
  # Heteroscedasticity test
  check_heteroscedasticity(model) %>% print()
  
}


## 2.2) ANOVA for Main Effects----

Anova.result <- list()
Comparison.result <- list()

for (i in seq_along(variable.name)) {
  
  df <- data.carbon.fraction %>%
    select(all_of(c("Sample.ID", "Pairs", "Status",
                    "Topography", variable.name[i]))) %>%
    rename("Variable" = variable.name[i])
  
  
  model <- lmer(Variable ~ Status * Topography + (1 | Pairs),
                data = df)
  
  if(variable.name[i] %in% c("SOC", "HFOC", "Moisture"))
  {Anova.result[[i]] <- Anova(model) %>%
    data.frame() %>%
    mutate(Term = row.names(.),
           Chisq = round(Chisq, 4)) %>%
    rename("P_value" = "Pr..Chisq.") %>%
    mutate(P_value = ifelse(P_value < 0.001, "P < 0.001",
                            round(P_value, 3)),
           P_value = as.character(P_value)) %>%
    {row.names(.) <- NULL;.} %>%
    select(Term, Chisq, Df, P_value)
  
  Comparison.result[[i]] <- model %>%
    emmeans(~ Status | Topography) %>%
    pairs(adjust = "tukey") %>%
    data.frame() %>%
    mutate(symbel = ifelse(p.value < 0.001, "<", "="),
           p.value1 = ifelse(p.value < 0.001, 0.001, p.value),
           label = paste("P", symbel, round(p.value1, 3))) %>%
    add_column(y.position = c(max(df$Variable[df$Topography == "Ridge"]),
                              max(df$Variable[df$Topography == "Valley"])))
  } else {
    
    vcovCR2 <- vcovCR(model, type = "CR2", cluster = df$Pairs)
    
    Anova.result[[i]] <- Anova(model, vcov. = vcovCR2) %>%
      data.frame() %>%
      mutate(Term = row.names(.),
             Chisq = round(Chisq, 4)) %>%
      rename("P_value" = "Pr..Chisq.") %>%
      mutate(P_value = ifelse(P_value < 0.001, "P < 0.001",
                              round(P_value, 3)),
             P_value = as.character(P_value)) %>%
      {row.names(.) <- NULL;.} %>%
      select(Term, Chisq, Df, P_value)
    
    Comparison.result[[i]] <- model %>%
      emmeans(~ Status | Topography, vcov. = vcovCR2) %>%
      pairs(adjust = "tukey") %>%
      data.frame() %>%
      mutate(symbel = ifelse(p.value < 0.001, "<", "="),
             p.value1 = ifelse(p.value < 0.001, 0.001, p.value),
             label = paste("P", symbel, round(p.value1, 3))) %>%
      add_column(y.position = c(max(df$Variable[df$Topography == "Ridge"]),
                                max(df$Variable[df$Topography == "Valley"])))
    
  }
  
  names(Anova.result)[i] <- variable.name[i]
  names(Comparison.result)[i] <- variable.name[i]
  
}


