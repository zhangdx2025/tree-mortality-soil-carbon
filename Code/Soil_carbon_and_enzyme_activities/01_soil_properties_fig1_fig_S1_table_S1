# 3. Relationship of ΔSOC vs Δaggregate----

carbon.fraction.change <- data.carbon.fraction %>%
  mutate(Status = factor(Status, levels = c("Before", "After"))) %>%
  group_by(Species, Topography, Pairs) %>%
  arrange(Status, .by_group = TRUE) %>%
  summarise(dSOC  = SOC[2]  - SOC[1],
            dLFOC = LFOC[2] - LFOC[1],
            dHFOC = HFOC[2] - HFOC[1],
            .groups = "drop")


## 3.1)  Ridge----
carbon.fraction.change.ridge <- carbon.fraction.change %>%
  subset(Topography == "Ridge")


### 3.1.1 Construct model----
modle.ridge <- lm(dSOC ~ dLFOC * dHFOC,
                  data = carbon.fraction.change.ridge)


### 3.1.2 Normality and Heteroscedasticity test----
check_normality(modle.ridge)
check_heteroscedasticity(modle.ridge)


### 3.1.3 Calculate slope and P-value----

# LFOC
emtrends(modle.ridge, var = "dLFOC", infer = c(TRUE, TRUE)) %>%
  summary()


# HFOC
emtrends(modle.ridge, var = "dHFOC", infer = c(TRUE, TRUE)) %>%
  summary()


### 3.1.4 Marginal dependence----
newdata.carbon.fraction.change.ridge <- data.frame(
  Fraction = factor(rep(c("dLFOC", "dHFOC"), each = 100),
                    levels = c("dLFOC", "dHFOC")),
  Carbon.content = c(seq(min(carbon.fraction.change.ridge$dLFOC),
                         max(carbon.fraction.change.ridge$dLFOC),
                         length.out = 100),
                     seq(min(carbon.fraction.change.ridge$dHFOC),
                         max(carbon.fraction.change.ridge$dHFOC),
                         length.out = 100))) %>%
  mutate(pred = case_when(
    Fraction == "dLFOC" ~ predict(
      modle.ridge,
      newdata = data.frame(dLFOC = Carbon.content,
                           dHFOC = mean(carbon.fraction.change.ridge$dHFOC))),
    Fraction == "dHFOC" ~ predict(
      modle.ridge,
      newdata = data.frame(dLFOC = mean(carbon.fraction.change.ridge$dLFOC),
                           dHFOC = Carbon.content))),
    se = case_when(
      Fraction == "dLFOC" ~ predict(
        modle.ridge,
        newdata = data.frame(dLFOC = Carbon.content,
                             dHFOC = mean(carbon.fraction.change.ridge$dHFOC)),
        se.fit = T)$se.fit,
      Fraction == "dHFOC" ~ predict(
        modle.ridge,
        newdata = data.frame(dLFOC = mean(carbon.fraction.change.ridge$dLFOC),
                             dHFOC = Carbon.content),
        se.fit = T)$se.fit),
    lower.fit = pred - 1.96 * se,
    upper.fit = pred + 1.96 * se) %>%
  select(Fraction, Carbon.content, pred, lower.fit, upper.fit)


