  scale_y_continuous(limits = c(-3, 3), breaks = seq(-3, 3, 1)) +
  labs(x = "PC1(59.3%)", y = "PC2(15.3%)") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"))


## 3.3) Pair comparison----
Enzyme <- c("PC1", "PC2")

SOC.enzyme.anova.result <- list()
SOC.enzyme.comparison.result <- list()
for (i in seq_along(Enzyme)) {
  df <- score.SOC.enzyme %>%
    select(all_of(c("Topography", "Status", "Pairs", Enzyme[i]))) %>%
    rename(Variable = Enzyme[i])
  
  model <- lmer(Variable ~ Topography * Status + (1|Pairs),
                data = df)
  
  print(Enzyme[i])
  check_normality(model) %>% print()
  check_heteroscedasticity(model) %>% print()
  
  SOC.enzyme.anova.result[[i]] <- Anova(model) %>%
    data.frame() %>%
    mutate(Term = row.names(.),
           Chisq = round(Chisq, 4)) %>%
    rename("P_value" = "Pr..Chisq.") %>%
    mutate(P_value = ifelse(P_value < 0.001, "P < 0.001",
                            round(P_value, 3)),
           P_value = as.character(P_value)) %>%
    {row.names(.) <- NULL;.} %>%
    select(Term, Chisq, Df, P_value)
  
  SOC.enzyme.comparison.result[[i]] <- model %>%
    emmeans(~ Status | Topography) %>%
    pairs(adjust = "tukey") %>%
    data.frame() %>%
    mutate(symbel = ifelse(p.value < 0.001, "<", "="),
           p.value1 = ifelse(p.value < 0.001, 0.001, p.value),
           label = paste("P", symbel, round(p.value1, 3))) %>%
    add_column(y.position = c(max(df$Variable[df$Topography == "Ridge"]),
                              max(df$Variable[df$Topography == "Valley"])))
  
  names(SOC.enzyme.anova.result)[i] <- Enzyme[i]
  names(SOC.enzyme.comparison.result)[i] <- Enzyme[i]
  
}

SOC.enzyme.anova.result %>%
  bind_rows(.id = "Enzyme")

SOC.enzyme.comparison.df <- SOC.enzyme.comparison.result %>%
  bind_rows(.id = "Enzyme")

SOC.enzyme.comparison.df


