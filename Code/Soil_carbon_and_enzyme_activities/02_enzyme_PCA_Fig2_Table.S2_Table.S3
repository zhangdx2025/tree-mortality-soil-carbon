# Set the working directory

setwd("~/R_Script")
path_properties <- file.path(getwd(), "Data/Soil_properties")

# 1. Loading package and data----


## 1.1) Package----
library(readxl)
library(tidyverse)
library(lme4)
library(performance)
library(emmeans)
library(car)
library(clubSandwich)
library(ggforce)
library(ggpubr)
library(vegan)
library(ggnewscale)
library(ggh4x)
library(psych)


## 1.2) Data----
data.mass.enzyme <- read_excel(file.path(path_properties,
                                          "soil.properties.xlsx"), sheet = "Data")

data.SOC.enzyme <- read_excel(file.path(path_properties,
                                        "soil.properties.xlsx"), sheet = "Data") %>%
  mutate(across(all_of(c("AG", "BG", "BX", "NAG", "PER", "PPO")), ~ (.x / SOC)))


## 1.3) Mapping----
mapping.fill <- c("Ridge_Alive" = "#FFE7D6", "Ridge_Dead" = "#FFA059",
                  "Valley_Alive" = "#C1E9FF", "Valley_Dead" = "#63C9FF")

mapping.color <- c("Ridge_Alive" = "#FFE7D6", "Ridge_Dead" = "#FFA059",
                   "Valley_Alive" = "#C1E9FF", "Valley_Dead" = "#63C9FF")

errorbar.color <- c("Ridge_Alive"  = "#E60012", 
                    "Ridge_Dead"   = "#E60012", 
                    "Valley_Alive" = "#0000FC",
                    "Valley_Dead"  = "#0000FC")


# 2 mass-specific enzyme activity----

## 2.1) PCA----
mass.enzyme.PCA <- data.mass.enzyme %>%
  select(all_of(c("AG", "BG", "BX", "NAG", "PER", "PPO"))) %>%
  principal(nfactors = 6, rotate = "none", scores   = TRUE, covar = FALSE)

summary(mass.enzyme.PCA)
mass.enzyme.PCA$Vaccounted
mass.enzyme.PCA$loadings


## 2.2) PCA visualization----
score.mass.enzyme <- data.mass.enzyme %>%
  mutate(PC1 = mass.enzyme.PCA$scores[, "PC1"],
         PC2 = mass.enzyme.PCA$scores[, "PC2"],
         Group = paste(Topography, Status, sep = "_"))

  
### 2.2.1 Table.S2----
matrix(as.numeric(mass.enzyme.PCA$loadings),
       nrow = nrow(mass.enzyme.PCA$loadings),
       ncol = ncol(mass.enzyme.PCA$loadings),
       dimnames = dimnames(mass.enzyme.PCA$loadings)) %>%
  round(3)


### 2.2.2 Fig.2a----
matrix(as.numeric(mass.enzyme.PCA$loadings),
       nrow = nrow(mass.enzyme.PCA$loadings),
       ncol = ncol(mass.enzyme.PCA$loadings),
       dimnames = dimnames(mass.enzyme.PCA$loadings)) %>%
  data.frame() %>%
  select(PC1, PC2) %>%
  mutate(Enzyme = row.names(.)) %>%
  ggplot(aes(x = PC1, y = PC2)) +
  geom_point(aes(x = PC1, y = PC2, fill = Group),
             size = 5, color = "#B2B2B2", shape = 21,
             show.legend = F,
             data = score.mass.enzyme, inherit.aes = F) +
  geom_hline(yintercept = 0, linetype = 2, color = "grey70") +
  geom_vline(xintercept = 0, linetype = 2, color = "grey70") +
  geom_segment(aes(x = 0, y = 0, xend = PC1 * 2, yend = PC2 * 2),
               arrow = arrow(length = unit(0.2, "cm")),
               linewidth = 0.8) +
  geom_text(aes(x = 2 * PC1, y = 2 * PC2, label = Enzyme),
            hjust = -0.1, vjust = -0.1, size = 4) +
  scale_fill_manual(values = mapping.fill) +
  scale_x_continuous(limits = c(-3, 3), breaks = seq(-3, 3, 1)) +
  scale_y_continuous(limits = c(-3.2, 3.2), breaks = seq(-3, 3, 1)) +
  labs(x = "PC1(44.0%)", y = "PC2(21.6%)") +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"))


## 2.3) Pair comparison----
Enzyme <- c("PC1", "PC2")

mass.enzyme.anova.result <- list()
mass.enzyme.comparison.result <- list()

for (i in seq_along(Enzyme)) {
  df <- score.mass.enzyme %>%
    select(all_of(c("Topography", "Status", "Pairs", Enzyme[i]))) %>%
    rename(Variable = Enzyme[i])
  
  model <- lmer(Variable ~ Topography * Status + (1|Pairs),
                data = df)
  
  print(Enzyme[i])
  check_normality(model) %>% print()
  check_heteroscedasticity(model) %>% print()
  
  mass.enzyme.anova.result[[i]] <- Anova(model) %>%
    data.frame() %>%
    mutate(Term = row.names(.),
           Chisq = round(Chisq, 4)) %>%
    rename("P_value" = "Pr..Chisq.") %>%
    mutate(P_value = ifelse(P_value < 0.001, "P < 0.001",
                            round(P_value, 3)),
           P_value = as.character(P_value)) %>%
    {row.names(.) <- NULL;.} %>%
    select(Term, Chisq, Df, P_value)
  
  mass.enzyme.comparison.result[[i]] <- model %>%
    emmeans(~ Status | Topography) %>%
    pairs(adjust = "tukey") %>%
    data.frame() %>%
    mutate(symbel = ifelse(p.value < 0.001, "<", "="),
           p.value1 = ifelse(p.value < 0.001, 0.001, p.value),
           label = paste("P", symbel, round(p.value1, 3))) %>%
    add_column(y.position = c(max(df$Variable[df$Topography == "Ridge"]),
                              max(df$Variable[df$Topography == "Valley"])))
  
  names(mass.enzyme.anova.result)[i] <- Enzyme[i]
  names(mass.enzyme.comparison.result)[i] <- Enzyme[i]
  
}


### 2.3.1 Table.S3----
mass.enzyme.anova.result %>%
  bind_rows(.id = "Enzyme")


## 2.4) Violin plot----
mass.enzyme.comparison.df <- mass.enzyme.comparison.result %>%
  bind_rows(.id = "Enzyme")

mass.enzyme.comparison.df


### 2.4.1 Fig.2c----
p.mass.enzyme <- score.mass.enzyme %>%
  select(Topography, Status, Pairs, PC1, PC2) %>%
  pivot_longer(cols = c("PC1", "PC2"),
               names_to = "Enzyme",
               values_to = "Value") %>%
  mutate(Group = paste(Topography, Status, sep = "_")) %>%
  ggplot(aes(x = Status, y = Value, fill = Group, color = Group)) +
  geom_violin(adjust = 1.5, bw = 1, alpha = 1,
              linewidth = 0.5, color = "#B2B2B2", show.legend = F, 
              trim = F, width = 0.6, scale = "width") +
  geom_point(aes(group = Status, Pairs = Pairs),
             shape = 21, size = 6, alpha = 1, color = "#B2B2B2",
             position = position_jitterdodge(jitter.width = 0.4,
                                             seed = 1234),
             show.legend = F) +
  geom_bracket(xmin = 1, xmax = 2, 
               aes(group = Topography,
                   y.position = y.position + 4.0,
                   label = label),
               data = mass.enzyme.comparison.df, inherit.aes = F,
               color = "black", label.size = 6,
               size = 0.5, vjust = -0.2,
               tip.length = 0.06) +
  facet_grid2(cols = vars(Enzyme), rows = vars(Topography),
              switch = "y", scales = "free_y", axes = "all",
              independent = "y") +
  labs(x = "Tree status", y = NULL) +
  scale_color_manual(values = mapping.color) +
  scale_fill_manual(values = mapping.fill) +
  theme_bw(base_size = 16) +
  theme(panel.grid = element_blank(),
        strip.placement = "outside",
        strip.background = element_blank(),
        panel.border = element_rect(colour = "black",
                                    linewidth = 1,
                                    fill = NA),
        axis.ticks.length.x = unit(-0.15, "cm"),
        axis.ticks.length.y = unit(-0.15, "cm"),
        plot.title = element_text(hjust = 0.5))

mass.enzyme.line.data <- ggplot_build(p.mass.enzyme)$data[[2]] %>%
  select(x, y, PANEL, group, Pairs) %>%
  group_by(PANEL, Pairs) %>%
  group_modify(function (data, group) {
    data.frame(
      x = c(data$x[1], data$x[1] + 0.3, data$x[2] - 0.3, data$x[2]),
      y = c(data$y[1], data$y[1], data$y[2], data$y[2])
    ) 
  }) %>%
  ungroup() %>%
  mutate(curve_id = interaction(PANEL, Pairs, drop = TRUE)) %>%
  left_join(ggplot_build(p.mass.enzyme)$layout$layout, by = "PANEL")

p.mass.enzyme + geom_bezier0(aes(x, y, group = curve_id),
                             data = mass.enzyme.line.data, colour = "grey70",
                             linewidth = 0.3,
                             inherit.aes = FALSE) +
  new_scale_color() +
  stat_summary(aes(color = Group),
               geom = "errorbar", fun.data = mean_sd,
               linewidth = 1,
               width = 0.1, show.legend = F) +
  stat_summary(aes(color = Group),
               geom = "point", fun = mean,
               size = 2,
               show.legend = F) +
  scale_y_continuous(limits = c(-6, 9), breaks = seq(-6, 9, 3)) +
  scale_color_manual(values = errorbar.color)


# 3 SOC-specific enzyme activity----

## 3.1) PCA----
SOC.enzyme.PCA <- data.SOC.enzyme %>%
  select(all_of(c("AG", "BG", "BX", "NAG", "PER", "PPO"))) %>%
  principal(nfactors = 6, rotate = "none", scores   = TRUE, covar = FALSE)

summary(SOC.enzyme.PCA)
SOC.enzyme.PCA$Vaccounted
SOC.enzyme.PCA$loadings


## 3.2) PCA visualization----
score.SOC.enzyme <- data.SOC.enzyme %>%
  mutate(PC1 = SOC.enzyme.PCA$scores[, "PC1"],
         PC2 = SOC.enzyme.PCA$scores[, "PC2"],
         Group = paste(Topography, Status, sep = "_"))


### 3.2.1 Table.S2----
matrix(as.numeric(SOC.enzyme.PCA$loadings),
